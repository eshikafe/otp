.{
    .name = "otp-generic-linux-build",
    .version = "0.1.0",
    .minimum_zig_version = "0.13.0",

    // scripts/update-otp.sh keeps the `otp` entry pointed at the latest
    // upstream release automatically; the OpenSSL pin is bumped manually
    // (deliberately - crypto bumps should be reviewed by a human).
    .dependencies = .{
        .otp = .{
            .url = "https://github.com/erlang/otp/releases/download/OTP-29.0.3/otp_src_29.0.3.tar.gz",
            .hash = "1220e10991c002205e06bd93a85c9d56e80da2c71a5e21e6a72daac711536c5b82a8",
        },
        .openssl = .{
            .url = "https://github.com/openssl/openssl/releases/download/openssl-3.3.1/openssl-3.3.1.tar.gz",
            .hash = "122036841d37585c881aa56891a05e16e32115c71c09eb831ab1225938603702f08d",
        },
    },

    .paths = .{
        "build.zig",
        "build.zig.zon",
        "scripts",
        "README.md",
    },
}
