.{
    .name = "otp-generic-linux-build",
    .version = "0.1.0",
    .minimum_zig_version = "0.13.0",

    // scripts/update-otp.sh keeps the `otp` entry pointed at the latest
    // upstream release automatically; the OpenSSL and ncurses pins are
    // bumped manually (deliberately - both are security/portability
    // sensitive and deserve a human review).
    .dependencies = .{
        .otp = .{
            .url = "https://github.com/erlang/otp/releases/download/OTP-27.3.4.18/otp_src_27.3.4.18.tar.gz",
            .hash = "12208fab726ecb39ec1e298ecf2a077a9bff2af480b11cdc545c1f6bdc1dc760c24f",
        },
        .openssl = .{
            .url = "https://github.com/openssl/openssl/releases/download/openssl-3.3.1/openssl-3.3.1.tar.gz",
            .hash = "122036841d37585c881aa56891a05e16e32115c71c09eb831ab1225938603702f08d",
        },
        .ncurses = .{
            .url = "https://ftp.gnu.org/gnu/ncurses/ncurses-6.6.tar.gz",
            .hash = "12202f0f19e4295c3a71ff0937022132b6554a7d7f4fbe5774508b9f25ea95163bde",
        },
    },

    .paths = .{
        "build.zig",
        "build.zig.zon",
        "scripts",
        "README.md",
    },
}
